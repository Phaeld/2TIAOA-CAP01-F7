  "components": {
    "schemas": {
      "Body_vision_api_v1_vision_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_vision_api_v1_vision_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "RiskCase": {
        "properties": {
          "middle_ages": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 18.0,
            "title": "Middle Ages"
          },
          "system_load": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "System Load"
          },
          "waiting_time": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Waiting Time"
          },
          "average_hr": {
            "type": "number",
            "maximum": 240.0,
            "minimum": 30.0,
            "title": "Average Hr"
          },
          "average_spo2": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 50.0,
            "title": "Average Spo2"
          },
          "systolic_bp": {
            "type": "number",
            "maximum": 250.0,
            "minimum": 50.0,
            "title": "Systolic Bp"
          },
          "temperature": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 10.0,
            "title": "Temperature"
          },
          "event_density": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Event Density"
          },
          "events_24h": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Events 24H"
          },
          "resource_availability": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Resource Availability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "middle_ages",
          "system_load",
          "waiting_time",
          "average_hr",
          "average_spo2",
          "systolic_bp",
          "temperature",
          "event_density",
          "events_24h",
          "resource_availability"
        ],
        "title": "RiskCase"
      },
      "Telemetry": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "event_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Event Id"
          },
          "device_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Device Id"
          },
          "patient_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Patient Id"
          },
          "temperature_c": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 10.0,
            "title": "Temperature C"
          },
          "heart_rate_bpm": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 30.0,
            "title": "Heart Rate Bpm"
          },
          "movement_detected": {
            "type": "boolean",
            "title": "Movement Detected",
            "default": true
          },
          "emergency_button_pressed": {
            "type": "boolean",
            "title": "Emergency Button Pressed",
            "default": false
          },
          "spo2_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Spo2 Percent"
          },
          "systolic_bp": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 250.0,
                "minimum": 50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Systolic Bp"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "device_id",
          "patient_id",
          "temperature_c",
          "heart_rate_bpm"
        ],
        "title": "Telemetry"
      },
      "TextRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 3,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "TextRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
